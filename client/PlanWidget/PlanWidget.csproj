<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用到 System.Windows.Forms.NotifyIcon（.NET 内置，非第三方 NuGet） -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PlanWidget</RootNamespace>
    <AssemblyName>PlanWidget</AssemblyName>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <AssemblyTitle>计划悬浮窗</AssemblyTitle>
    <Product>计划悬浮窗</Product>
    <Description>计划悬浮窗桌面悬浮窗插件（客户端原型）</Description>
    <ApplicationIcon>Resources\plan-widget.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\plan-widget.ico" />
  </ItemGroup>


  <!-- 移除 UseWindowsForms 注入的全局 using，避免与 WPF 类型歧义；WinForms 类型用全限定名调用 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
<Window x:Class="PlanWidget.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- 表单标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- 输入框 -->
        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <!-- 次级按钮 -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 行布局助手 -->
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="14" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel Margin="18">
                <!-- 标题栏 -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="设置" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCloseHeader" Content="&#x2715;" HorizontalAlignment="Right"
                            Width="26" Height="26" Click="Close_Click" Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="13" Cursor="Hand" Background="Transparent"/>
                </Grid>

                <!-- 计划文件 -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="计划文件" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtPlanState" Grid.Column="1" Style="{StaticResource TextInput}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnPlanFile" Content="浏览" Style="{StaticResource SmallBtn}" Click="BrowsePlanFile_Click"/>
                        <Button x:Name="BtnPlanFolder" Content="选文件夹" Style="{StaticResource SmallBtn}" Click="BrowsePlanFolder_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PlanHint" Visibility="Collapsed" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,-6,0,8"
                           TextWrapping="Wrap"/>

                <!-- 会话状态文件 -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="会话状态" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtSessionStatus" Grid.Column="1" Style="{StaticResource TextInput}"/>
                    <Button x:Name="BtnSessionFile" Grid.Column="2" Content="浏览" Style="{StaticResource SmallBtn}" Click="BrowseSessionFile_Click"/>
                </Grid>

                <TextBlock x:Name="SessionHint" Visibility="Collapsed" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,-6,0,8"
                           TextWrapping="Wrap"/>

                <!-- 轮询间隔 -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="轮询间隔(ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtPollMs" Grid.Column="1" Style="{StaticResource TextInput}" Text="1000"/>
                </Grid>

                <!-- 主题 -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主题" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbTheme" Grid.Column="1" FontSize="12.5" Padding="8,5">
                        <ComboBoxItem Content="浅色（Light）"/>
                        <ComboBoxItem Content="深色（Dark）"/>
                    </ComboBox>
                </Grid>

                <!-- 状态面板默认展开 -->
                <Grid Style="{StaticResource RowGrid}">
                    <CheckBox x:Name="ChkSessionDefault" Content="启动时默认展开会话状态面板"
                              FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <!-- 边缘吸附 -->
                <Grid Style="{StaticResource RowGrid}">
                    <CheckBox x:Name="ChkSnap" Content="边缘吸附（贴边自动折叠，鼠标靠近自动展开）"
                              FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="BtnShortcut" Content="创建桌面快捷方式" Style="{StaticResource SmallBtn}" Click="CreateShortcut_Click"/>
                    <Button x:Name="BtnOk" Content="确定" Style="{StaticResource PrimaryBtn}" MinWidth="72" Click="Ok_Click"/>
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SmallBtn}" MinWidth="72" Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>